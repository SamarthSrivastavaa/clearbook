{
  "name": "clearbook",
  "version": "0.0.0",
  "private": true,
  "description": "Clearbook \u2014 evidence-bound covenant compliance for credit originators",
  "type": "module",
  "scripts": {
    "gate0": "tsx integration/gate0-capabilities.ts",
    "gate0:lag": "tsx integration/gate0-lag.ts",
    "gate1": "tsx integration/gate1-evidence.ts",
    "gate2": "tsx integration/gate2-proof.ts",
    "lint": "solhint \"contracts/src/**/*.sol\" --config contracts/.solhint.json && solhint \"contracts/test/**/*.sol\" --config contracts/test/.solhint.json",
    "check:predicate": "tsx frontend/scripts/check-predicate.ts",
    "check:verify": "tsx frontend/scripts/check-verify.ts",
    "gate7": "tsx integration/gate7-forged.ts",
    "latency": "tsx integration/measure-latency.ts",
    "demo:stage": "tsx demo/stage-source.ts",
    "demo:prove": "tsx demo/prove-staged.ts",
    "demo:run": "tsx demo/run.ts",
    "gate4": "tsx integration/gate4-decode.ts",
    "demo:seed": "tsx demo/seed.ts",
    "demo:reset": "tsx demo/reset.ts",
    "recheck": "tsx integration/recheck-controls.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@gluwa/usc-contracts": "0.2.0",
    "@gluwa/usc-sdk": "0.18.0",
    "@openzeppelin/contracts": "5.1.0",
    "dotenv": "17.4.2",
    "ethers": "6.17.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "solhint": "6.2.4",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
